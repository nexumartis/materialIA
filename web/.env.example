# Base de la API FastAPI (sin barra final). Por defecto el backend local.
VITE_API_BASE=http://127.0.0.1:8077

# Supabase Auth (registro / login del panel). Ambas son PÚBLICAS por diseño (la anon key
# sólo permite lo que habilitan RLS y Auth), pero igual van en .env, no en el código.
# Local: "Project URL" y "anon key" de `supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
