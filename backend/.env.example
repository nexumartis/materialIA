# Copiá este archivo a `.env` (NO versionado) y completá los valores.
# Nunca pongas secretos reales en el repo ni en el chat.

# --- Base de datos -----------------------------------------------------------
# LOCAL (default de `supabase start`):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# REMOTO DEV (Supabase cloud). Tomá el connection string de:
#   Dashboard > Project Settings > Database > Connection string (usar el "Session"/pooler
#   o el directo). La contraseña es la de la base del proyecto, no se commitea.
# DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.zfmjcturyhxytyfzmcha.supabase.co:5432/postgres

# --- Supabase Auth (panel) -----------------------------------------------------
# URL del proyecto: los JWT se verifican con su JWKS (claves públicas). No es secreto.
# Local: la "Project URL" de `supabase status`. Remoto: https://<ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

APP_ENV=local
# Mutaciones administrativas del sandbox SIN cuenta (/sandbox/catalog/import, /sandbox/orders/{id}/status,
# PATCH /sandbox/opportunities/{id}, /sandbox/maintenance/expire-reservations). Apagadas por defecto
# (404). SANDBOX_ADMIN=1 las habilita sólo con APP_ENV=local; fuera de local no tiene efecto.
# El chat demo, la tienda pública y el checkout simulado no dependen de esto.
SANDBOX_ADMIN=0
DEMO_DEFAULT_TENANT=0000000a-0000-0000-0000-00000000000a

# --- LLM (intercambiable) ----------------------------------------------------
# Opciones de LLM_PROVIDER:
#   mock    -> reglas deterministas, sin LLM (default, sin costo)
#   ollama  -> modelo LOCAL gratis (requiere Ollama corriendo). Sin API key.
#   openai  -> API (requiere LLM_API_KEY). Modelo económico, de pago.
LLM_PROVIDER=mock

# Ollama (gratis, local). Necesitás: `ollama serve` y `ollama pull qwen3:4b`.
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# OpenAI-compatible (de pago)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
LLM_MODEL=gpt-6-luna
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_S=60
LLM_MAX_OUTPUT_TOKENS=500

# --- Ventas: pagos y reservas de stock -------------------------------------------
# simulated   -> checkout de PRUEBA propio, sin credenciales (default). No cobra nada.
# mercadopago -> Checkout Pro. Usar SOLO credenciales de PRUEBA en desarrollo.
PAYMENT_PROVIDER=simulated
# MP_ACCESS_TOKEN=TEST-...           # Mercado Pago > Tus integraciones > Credenciales de prueba
# MP_WEBHOOK_SECRET=...              # Mercado Pago > Webhooks > Clave secreta
# URL pública del backend (links del checkout simulado y notification_url de Mercado Pago).
# Para recibir webhooks reales en local hace falta un túnel (p. ej. cloudflared/ngrok).
PUBLIC_BASE_URL=http://127.0.0.1:8077
# Minutos que se aparta el stock esperando el pago.
RESERVATION_MINUTES=30
# Worker (python -m app.worker): segundos entre vueltas.
WORKER_INTERVAL_S=60

# --- Memoria y contexto del agente (los aplica el worker: python -m app.worker) -------
MEMORY_IDLE_MINUTES=10          # inactividad antes de destilar la memoria del cliente
COMPACT_AFTER_MESSAGES=30       # mensajes a partir de los cuales se resume lo viejo
# Embeddings para la base de conocimiento (vacío = sólo búsqueda de texto en español).
# EMBEDDING_MODEL=nomic-embed-text
