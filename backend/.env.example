# Copiá este archivo a `.env` (NO versionado) y completá los valores.
# Nunca pongas secretos reales en el repo ni en el chat.

# --- Base de datos -----------------------------------------------------------
# LOCAL (default de `supabase start`):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# REMOTO DEV (Supabase cloud). Tomá el connection string de:
#   Dashboard > Project Settings > Database > Connection string (usar el "Session"/pooler
#   o el directo). La contraseña es la de la base del proyecto, no se commitea.
# DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.zfmjcturyhxytyfzmcha.supabase.co:5432/postgres

APP_ENV=local
DEMO_DEFAULT_TENANT=0000000a-0000-0000-0000-00000000000a

# --- LLM (intercambiable) ----------------------------------------------------
# Sin LLM_API_KEY el backend corre en modo MOCK explícito (reglas deterministas).
LLM_PROVIDER=mock
LLM_MODEL=gpt-6-luna
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_S=20
LLM_MAX_OUTPUT_TOKENS=500
