# Copiá este archivo a `.env` (NO versionado) y completá los valores.
# Nunca pongas secretos reales en el repo ni en el chat.

# --- Base de datos -----------------------------------------------------------
# LOCAL (default de `supabase start`):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# REMOTO DEV (Supabase cloud). Tomá el connection string de:
#   Dashboard > Project Settings > Database > Connection string (usar el "Session"/pooler
#   o el directo). La contraseña es la de la base del proyecto, no se commitea.
# DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.zfmjcturyhxytyfzmcha.supabase.co:5432/postgres

# --- Supabase Auth (panel) -----------------------------------------------------
# URL del proyecto: los JWT se verifican con su JWKS (claves públicas). No es secreto.
# Local: la "Project URL" de `supabase status`. Remoto: https://<ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

APP_ENV=local
# Mutaciones administrativas del sandbox SIN cuenta (/sandbox/catalog/import, /sandbox/orders/{id}/status,
# PATCH /sandbox/opportunities/{id}, /sandbox/maintenance/expire-reservations). Apagadas por defecto
# (404). SANDBOX_ADMIN=1 las habilita sólo con APP_ENV=local; fuera de local no tiene efecto.
# El chat demo, la tienda pública y el checkout simulado no dependen de esto.
SANDBOX_ADMIN=0

# API Georef (datos.gob.ar, gratis y sin clave): ubica «Bernal» dentro de la zona «Quilmes» o «Zona Sur».
# Vacío = apagada (se compara sólo por texto).
GEOREF_URL=https://apis.datos.gob.ar/georef/api
DEMO_DEFAULT_TENANT=0000000a-0000-0000-0000-00000000000a

# --- LLM (intercambiable) ----------------------------------------------------
# Opciones de LLM_PROVIDER:
#   mock    -> reglas deterministas, sin LLM (default, sin costo)
#   ollama  -> modelo LOCAL gratis (requiere Ollama corriendo). Sin API key.
#   openai  -> API (requiere LLM_API_KEY). Modelo económico, de pago.
LLM_PROVIDER=mock

# Ollama (gratis, local). Necesitás: `ollama serve` y `ollama pull qwen3:4b`.
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# OpenAI-compatible (de pago)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
LLM_MODEL=gpt-6-luna
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_S=60
LLM_MAX_OUTPUT_TOKENS=500

# --- Ventas: pagos y reservas de stock -------------------------------------------
# simulated   -> checkout de PRUEBA propio, sin credenciales (default). No cobra nada.
# mercadopago -> Checkout Pro. Usar SOLO credenciales de PRUEBA en desarrollo.
PAYMENT_PROVIDER=simulated
# MP_ACCESS_TOKEN=TEST-...           # Mercado Pago > Tus integraciones > Credenciales de prueba
# MP_WEBHOOK_SECRET=...              # Mercado Pago > Webhooks > Clave secreta
# URL pública del backend (links del checkout simulado y notification_url de Mercado Pago).
# Para recibir webhooks reales en local hace falta un túnel (p. ej. cloudflared/ngrok).
PUBLIC_BASE_URL=http://127.0.0.1:8077
# Panel/tienda pública: links en los mensajes de campañas.
PUBLIC_WEB_URL=http://localhost:5173
# Canales de campañas. En esta fase sólo «simulado»: no se envía nada a clientes.
CAMPAIGN_CHANNELS=simulado
# Minutos que se aparta el stock esperando el pago.
RESERVATION_MINUTES=30
# Worker (python -m app.worker): segundos entre vueltas.
WORKER_INTERVAL_S=60

# --- Memoria y contexto del agente (los aplica el worker: python -m app.worker) -------
MEMORY_IDLE_MINUTES=10          # inactividad antes de destilar la memoria del cliente
COMPACT_AFTER_MESSAGES=30       # mensajes a partir de los cuales se resume lo viejo
# Embeddings para la base de conocimiento (vacío = sólo búsqueda de texto en español).
# EMBEDDING_MODEL=nomic-embed-text

# Precio del modelo por millón de tokens (entrada / salida) para estimar el costo de IA por negocio
# en «Ajustes del agente». Sin precio, se muestra el uso pero no un costo.
# LLM_PRICE_IN_PER_MTOK=0.15
# LLM_PRICE_OUT_PER_MTOK=0.60
# LLM_PRICE_CURRENCY=USD

# Frenos de abuso y gasto (0 = sin límite). Ver backend/app/domain/limits.py.
RATE_IP_PER_MINUTE=12
RATE_IP_PER_DAY=400
RATE_CONVERSATION_PER_HOUR=90
RATE_STORE_PER_HOUR=1500
RATE_USER_AI_PER_MINUTE=20
AI_DAILY_CALLS_PER_TENANT=1500
AI_DAILY_TOKENS_PER_TENANT=3000000
AI_DAILY_CALLS_GLOBAL=20000
AI_DAILY_TOKENS_GLOBAL=40000000
LLM_MAX_OUTPUT_TOKENS=4000
# Proxies que agregan X-Forwarded-For delante del backend (Cloud Run directo: 1). 0 = local.
TRUSTED_PROXY_HOPS=0

# Producción/staging (APP_ENV=production|staging): el servidor NO arranca con PAYMENT_PROVIDER=simulated,
# CORS abierto o SANDBOX_ADMIN, y las rutas /sandbox dan 404. Orígenes del panel, separados por coma:
CORS_ORIGINS=

# WhatsApp (Cloud API de Meta). Sin estos tres valores queda apagado. Ver docs/whatsapp-pruebas.md.
# App Secret: app de Meta → Configuración de la app → Básica.
WHATSAPP_APP_SECRET=
# Lo inventamos nosotros y se pega igual en la configuración del webhook de la app de Meta.
WHATSAPP_VERIFY_TOKEN=
# Cifra el token de cada local. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WHATSAPP_TOKEN_KEY=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_PER_CONTACT_HOUR=60

# Audio web ElevenLabs: APAGADO. No completar credenciales durante pruebas simuladas.
# Sólo UN tenant demo del seed C/D; no acepta tenant, modelo ni voz del navegador.
AUDIO_DEMO_ENABLED=0
AUDIO_DEMO_TENANT=
AUDIO_API_KEY=
AUDIO_VOICE_ID=
AUDIO_TTS_MODEL=eleven_multilingual_v2
# Entrada obligatoria: WAV PCM mono 16000 Hz, 16 bits. Duración verificada en backend.
AUDIO_MAX_UPLOAD_BYTES=1000000
AUDIO_MAX_DURATION_SECONDS=30
AUDIO_MAX_TTS_CHARACTERS=2000
AUDIO_MAX_RESPONSE_BYTES=1000000
AUDIO_UPLOAD_TIMEOUT_SECONDS=10
AUDIO_PROVIDER_TIMEOUT_SECONDS=20
# Todos obligatoriamente positivos: cero/inválido impide arrancar, nunca significa ilimitado.
# Llamadas STT+TTS comparten estos contadores. Ventanas diarias UTC.
AUDIO_IP_PER_MINUTE=3
AUDIO_CONVERSATION_PER_HOUR=10
AUDIO_DAILY_CALLS_PER_TENANT=100
AUDIO_DAILY_CALLS_GLOBAL=200
AUDIO_DAILY_STT_BYTES_PER_TENANT=30000000
AUDIO_DAILY_STT_BYTES_GLOBAL=60000000
AUDIO_DAILY_TTS_CHARACTERS_PER_TENANT=20000
AUDIO_DAILY_TTS_CHARACTERS_GLOBAL=40000
# Reservas previas y sin devolución: errores/timeouts también consumen cuota local.
# Estas unidades NO constituyen un límite monetario. Configurar además el freno del proveedor.
# No se promete zero-retention: enable_logging=false es exclusivo enterprise.
# Ver docs/audio-web.md; sin retries automáticos ni persistencia de originales.

# Fotos del cliente (buscar en el catálogo por foto). Vacío = apagado.
VISION_PROVIDER=
VISION_MODEL=

# Mercado Pago por negocio (OAuth): cada comercio conecta SU cuenta y cobra en ella.
# Credenciales de NUESTRA aplicación en developers.mercadopago.com (redirect: <PUBLIC_BASE_URL>/mp/oauth/callback).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Clave Fernet para cifrar los tokens de cada negocio:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MP_TOKEN_KEY=
